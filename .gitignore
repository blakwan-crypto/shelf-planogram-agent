# Python
__pycache__/
*.pyc
.venv/

# Model weights — download link in models/README.md (never commit weights)
models/*.pt
models/*.onnx

# Secrets — copy .env.example to .env and fill in real values locally
.env

# macOS noise
.DS_Store

# Parallel-agent working files (not project content)
.agent-tasks/
.agent-logs/

# Generated results stay local until curated for submission
results/traces/*.jsonl

# HyperFrames generated caches and review stills
videos/**/.media/
videos/**/.thumbnails/
videos/**/snapshots/
videos/**/renders/verify/


# Per-run pipeline outputs — regenerated on every run; only the curated
# demo image (used in the README) and the eval/scenario evidence stay tracked
results/images/*
!results/images/.gitkeep
!results/images/shelf3_annotated.jpg
results/tasks/
results/metrics.json

# Scenario-suite per-scenario outputs — regenerated by tests/run_scenarios.py;
# only the top-level summary report stays tracked
results/scenarios/*/
